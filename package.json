{
  "name": "intellisense-bootstrap-5-by-pirulug",
  "displayName": "IntelliSense Bootstrap 5 by Pirulug",
  "description": "Bootstrap 5 IntelliSense for Visual Studio Code. Provides fast and accurate CSS class autocompletion for HTML and PHP, including HTML embedded in PHP strings.",
  "publisher": "pirulug",
  "version": "0.0.2",
  "license": "MIT",
  "homepage": "https://github.com/pirulug/bootstrap5-intellisense#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pirulug/bootstrap5-intellisense.git"
  },
  "bugs": {
    "url": "https://github.com/pirulug/bootstrap5-intellisense/issues"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "bootstrap",
    "bootstrap 5",
    "bootstrap5",
    "css",
    "html",
    "php",
    "intellisense",
    "autocomplete",
    "web",
    "frontend",
    "vscode"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html",
          ".htm"
        ]
      },
      {
        "id": "php",
        "extensions": [
          ".php"
        ]
      }
    ],
    "configurationDefaults": {
      "[html]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      },
      "[php]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}